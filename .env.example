# Copy this file to .env. Replace every value before starting the server.
# Generate random values with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_HMAC_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
DEVICE_CONNECTION_TOKEN=REPLACE_WITH_A_LONG_RANDOM_DEVICE_TOKEN
MOBILE_WS_TOKEN=REPLACE_WITH_A_LONG_RANDOM_MOBILE_TOKEN

# Personal-install owner credentials. Never reuse a bank, email, or phone PIN.
OWNER_USERNAME=owner
OWNER_PIN=REPLACE_WITH_A_NEW_6_TO_12_DIGIT_PIN

# Add your deployed dashboard URL after creating it, for example:
# ALLOWED_ORIGINS=https://your-doorbell.onrender.com

# Use a persistent mounted directory in cloud deployments.
DATA_DIR=./data
# Optional Expo enhanced push-security access token (server only).
# EXPO_ACCESS_TOKEN=
