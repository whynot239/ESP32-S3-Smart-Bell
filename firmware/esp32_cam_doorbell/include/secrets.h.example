#pragma once

// Copy this file to secrets.h. It is deliberately ignored by Git.
#define WIFI_SSID "YOUR_WIFI_NAME"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Render/cloud example: your-doorbell.onrender.com, port 443, SSL true.
// Local example: 192.168.1.100, port 3000, SSL false.
#define BACKEND_HOST "YOUR_BACKEND_HOST"
#define BACKEND_PORT 443
#define BACKEND_USE_SSL true

// Must exactly match DEVICE_HMAC_KEY and DEVICE_CONNECTION_TOKEN in the server environment.
#define DEVICE_HMAC_KEY "REPLACE_WITH_64_RANDOM_HEX_CHARACTERS"
#define DEVICE_CONNECTION_TOKEN "REPLACE_WITH_A_LONG_RANDOM_DEVICE_TOKEN"

// PEM root CA for your backend TLS certificate chain. Empty refuses TLS.
static const char backendRootCa[] = R"PEM(-----BEGIN CERTIFICATE-----
REPLACE_WITH_TRUSTED_ROOT_CA
-----END CERTIFICATE-----
)PEM";

#define BACKEND_ROOT_CA backendRootCa
